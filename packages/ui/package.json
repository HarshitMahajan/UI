{
  "name": "@harshitmahajan/ui",
  "version": "0.1.0",
  "description": "1126 Labs internal design system: Base UI components with a single token file.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "rules",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "default": "./dist/lib/cn.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@fontsource-variable/inter": ">=5.0.0",
    "@fontsource-variable/newsreader": ">=5.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "@fontsource-variable/inter": {
      "optional": true
    },
    "@fontsource-variable/newsreader": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshitMahajan/UI.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
