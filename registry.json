{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ui-kit",
  "homepage": "https://github.com/HarshitMahajan/UI",
  "items": [
    {
      "name": "tokens",
      "type": "registry:item",
      "title": "Tokens",
      "description": "The few tokens UI Kit components add to a shadcn app. Installed with any component.",
      "cssVars": {
        "theme": {
          "color-success": "var(--success)",
          "color-danger": "var(--danger)",
          "color-warning": "var(--warning)",
          "color-info": "var(--info)",
          "color-destructive-foreground": "var(--destructive-foreground)"
        },
        "light": {
          "success": "hsl(142 76% 36%)",
          "danger": "hsl(0 72% 51%)",
          "warning": "hsl(21 90% 48%)",
          "info": "hsl(221 83% 53%)",
          "destructive-foreground": "hsl(0 0% 98%)"
        },
        "dark": {
          "success": "hsl(142 69% 58%)",
          "danger": "hsl(0 91% 71%)",
          "warning": "hsl(27 96% 61%)",
          "info": "hsl(213 94% 68%)",
          "destructive-foreground": "hsl(0 0% 98%)"
        }
      }
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "Optional: replaces the app's colors and corners with the full UI Kit look.",
      "cssVars": {
        "theme": {
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
